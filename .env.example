# 程序说明：配置模板，复制为 .env 后填写真实值；不要提交密钥。
# 离线开关：1 强制使用本地模拟模型，不产生任何外部请求。
GREY_ZONE_OFFLINE=1
# 日志目录与级别（DEBUG / INFO / WARNING）。
GREY_ZONE_LOG_DIR=data/logs
GREY_ZONE_LOG_LEVEL=INFO

# 情节导演开关。
AI_DIRECTOR_ENABLED=0

# 在线 Provider 选择；留空则使用模拟模型。
AI_CURRENT_PROVIDER=1
AI_CURRENT_MODEL=1.1

AI_PROVIDER_1_NAME=<provider-name>
AI_PROVIDER_1_BASE_URL=<https://example.com/v1>
AI_PROVIDER_1_API_KEY=<your-api-key>
AI_PROVIDER_1_TIMEOUT_SECONDS=60
AI_PROVIDER_1_MAX_RETRIES=2

AI_MODEL_1_1_NAME=<model-name>
